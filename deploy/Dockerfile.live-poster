# Image for the sylox-live-poster Railway cron service: runs ONE
# deploy/post-demo-signals.sh testnet --live pass per invocation, then
# exits (restart policy: Never - each run is one pass, not a daemon).
#
# Debian slim, not node:*-slim (unlike web/app/Dockerfile): this image
# runs a bash script, not a Node build; Node is not needed at all.
#
# Builds from the repo root (`docker build -f deploy/Dockerfile.live-poster .`),
# the same convention web/app/Dockerfile uses, so deploy/'s own helper
# scripts (shared between the two) resolve the same relative paths
# whether run locally or in this container.
#
# --platform=linux/amd64 is PINNED here, in the Dockerfile itself, not
# left to a --platform flag on whatever build command happens to be
# run. Railway's own infrastructure is x86_64; pinning it here means
# every build - local or CI - targets the same real architecture the
# stellar-cli binary below actually is, rather than silently building
# for the host's own native arch (reproduced directly while writing
# this file: an unpinned build on an arm64 Mac downloaded and
# extracted the binary fine, then failed to run it in the same build
# step). This also means local builds run under QEMU emulation on
# Apple Silicon, which is slower than a native build - expected, not
# a problem with this file.
#
# BuildKit's own linter flags a literal --platform value here
# ("FromPlatformFlagConstDisallowed") because it's usually meant to be
# a build ARG for cross-compiling multiple targets from one
# Dockerfile. That flexibility is deliberately NOT wanted here: this
# image has exactly one real target (Railway's x86_64), so the
# constant is the point, not an oversight - a stray --platform flag on
# some future build invocation should never be able to silently
# change what this image actually targets.
FROM --platform=linux/amd64 debian:bookworm-slim

# jq: used throughout deploy/post-demo-signals.sh to build/parse
#   signal JSON.
# curl: fetches the stellar-cli release tarball below, nothing else
#   at runtime (no network calls at runtime beyond what `stellar`
#   itself makes).
# ca-certificates: both curl (the release download) and the stellar
#   CLI's own RPC/Horizon calls need real TLS verification.
# libdbus-1-3: the stellar binary itself needs libdbus-1.so.3 at
#   runtime (its own OS-native secure-store key support links against
#   it even when that feature is never used here) - found by the
#   `stellar --version` check below failing with "error while loading
#   shared libraries: libdbus-1.so.3: cannot open shared object file"
#   once the build actually ran the real x86_64 binary (platform
#   pinned above) instead of just extracting it.
RUN apt-get update && apt-get install -y --no-install-recommends \
      jq \
      curl \
      ca-certificates \
      libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

# stellar-cli 28.1.0 from the official release binary, checksum
# verified against the SAME value .github/workflows/ci.yml pins
# (STELLAR_CLI_SHA256) - one source of truth for this number, not a
# second copy that could drift from CI's own. cargo install is
# deliberately NOT used: it would compile from source inside the
# build (slow, and pulls in the full Rust toolchain this image has no
# other use for), when the project's own CI already downloads and
# verifies this exact prebuilt binary.
#
# The final `stellar --version` actually EXECUTES the extracted
# binary and greps its output for the exact pinned version string -
# this is deliberate, not just a sanity echo: with --platform=linux/
# amd64 pinned on the FROM line above, this step runs the binary for
# real (under QEMU emulation on an arm64 build host, natively on a
# real x86_64 one), so it catches a wrong binary, a wrong
# architecture, or a checksum that verified but still didn't produce
# a working executable - on this machine AND on Railway's own build,
# not just locally. This exact check is what caught the original bug
# in this file (an earlier version omitted --platform, built for the
# host's own native arch by default, and failed here) - keep it.
ARG STELLAR_CLI_VERSION=28.1.0
ARG STELLAR_CLI_SHA256=c1680deee94301d33ada7a17f98411e642a4248c727afbd2e43050d345746462
RUN curl -sSfL "https://github.com/stellar/stellar-cli/releases/download/v${STELLAR_CLI_VERSION}/stellar-cli-${STELLAR_CLI_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
      -o /tmp/stellar-cli.tar.gz \
    && echo "${STELLAR_CLI_SHA256}  /tmp/stellar-cli.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/stellar-cli.tar.gz -C /usr/local/bin stellar \
    && rm /tmp/stellar-cli.tar.gz \
    && stellar --version | grep -qF "${STELLAR_CLI_VERSION}"

WORKDIR /app

# Only deploy/ and the current deployment records, not the whole repo
# (unlike web/app/Dockerfile, which needs the full monorepo for npm
# workspace resolution): this image has no other dependency.
# testnet-demo-asset*.json (DEMOUSD's own testnet-demo-asset.json, plus
# any testnet-demo-asset-<code>.json a second demo asset's own
# deploy/demo-asset.sh testnet <code> run committed) is needed
# alongside testnet.json so deploy/extend-ttl.sh can find every demo
# asset's contract and holder addresses without anything beyond what's
# already copied in. The glob always matches at least
# testnet-demo-asset.json, which is always committed.
COPY deploy/ deploy/
COPY deployments/testnet.json deployments/testnet.json
COPY deployments/testnet-demo-asset*.json deployments/

ENTRYPOINT ["deploy/live-poster-entrypoint.sh"]
