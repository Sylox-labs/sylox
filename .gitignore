# deploy/deploy.sh testnet writes deployments/testnet.json fresh every
# run and it is committed (no secret key ever appears in it; see
# deploy/deploy.sh's own header). Everything else under deployments/
# (ad hoc local scratch, e.g. deploy/post-demo-signals.sh's own
# inputs record) stays ignored.
deployments/*.json
!deployments/testnet.json

