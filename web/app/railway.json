{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm run build -w web/app",
    "watchPatterns": [
      "/web/app/**",
      "/web/shared/**",
      "/deployments/**",
      "/package.json",
      "/package-lock.json",
      "/railpack.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start -w web/app -- -p $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
