{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm run build -w web/landing",
    "watchPatterns": [
      "/web/landing/**",
      "/web/shared/**",
      "/package.json",
      "/package-lock.json",
      "/railway.json",
      "/railpack.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run serve -w web/landing",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
